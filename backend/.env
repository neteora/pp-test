APP_ENV=dev
APP_SECRET=change-me-in-env-local
DATABASE_URL="mysql://postpickr:postpickr@mysql:3306/postpickr?serverVersion=8.0&charset=utf8mb4"
CORS_ALLOW_ORIGIN='^http://localhost:8097$'

# LLM provider (one adapter class per provider; model/key/params are configuration)
#LLM_API_KEY=
LLM_TIMEOUT=30

# Storage media su disco (public/uploads). Instagram scarica l'immagine da questo URL:
# per la pubblicazione reale deve essere pubblico e HTTPS (es. tunnel verso la porta dell'API)
MEDIA_PUBLIC_BASE_URL=http://localhost:8095/uploads

# Instagram Graph API
#IG_GRAPH_BASE=https://graph.facebook.com
IG_GRAPH_VERSION=v23.0